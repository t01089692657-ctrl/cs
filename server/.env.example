# ============================================================
# 外贸全链路 AI 系统 · 服务器环境配置
# 用法：复制本文件为 .env，填入真实值。
# 关键设计：某项能力的 key 填了就自动“真实生效”，没填就“演示模式”。
#          所以你可以先只填第一批，逐步再填后面的，系统随时可用。
# ============================================================

# ---------- 基础 ----------
PORT=8080
# 登录令牌签名密钥：随便一串长随机字符串，务必修改
JWT_SECRET=change-me-to-a-long-random-string
# 首个管理员账号（首次启动自动创建）
ADMIN_EMAIL=boss@yourcompany.com
ADMIN_PASSWORD=change-this-password

# ---------- 数据库（不填则用内存演示库，重启即清空） ----------
# 例：postgres://user:pass@localhost:5432/waimao
DATABASE_URL=

# ---------- 第一批：核心（接上就能真用） ----------
# 大模型（打分/写开发信/脚本）。provider 任选：openai / deepseek / qwen / claude
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 可选：自定义兼容 OpenAI 的 base url（deepseek/qwen 已内置，无需填）
LLM_BASE_URL=
LLM_MODEL=

# 发信邮箱 SMTP（真实发送开发信）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=

# ---------- 第二批：获客引擎 ----------
# 抓取：Crawl4AI 自建服务地址（跑大批量）
CRAWL4AI_URL=
# 抓取：Firecrawl（兜底反爬），托管 API key
FIRECRAWL_API_KEY=
# 搜索找公司：SerpAPI key
SERPAPI_KEY=
# 找邮箱：hunter / apollo
EMAIL_FINDER_PROVIDER=hunter
EMAIL_FINDER_KEY=
# 海关数据（可选）：volza key（ImportYeti 无公开 API，走抓取）
CUSTOMS_API_KEY=

# ---------- 第三批：内容与触达（可延后） ----------
# 视频生成：provider=keling/jimeng/hailuo，url+key
VIDEO_API_PROVIDER=
VIDEO_API_URL=
VIDEO_API_KEY=
# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ---------- 文件存储（产品图/视频，不填则存服务器本地磁盘） ----------
# 例：阿里云 OSS / 腾讯云 COS，留空用本地 ./storage
OSS_ENDPOINT=
OSS_BUCKET=
OSS_KEY=
OSS_SECRET=
