# ============================================================
# 外贸全链路 AI 系统 · 服务器环境配置
# 用法：复制本文件为 .env，填入真实值。
# 关键设计：某项能力的 key 填了就自动“真实生效”，没填就“演示模式”。
#          所以你可以先只填第一批，逐步再填后面的，系统随时可用。
# ============================================================

# ---------- 基础 ----------
PORT=8080
# 登录令牌签名密钥：随便一串长随机字符串，务必修改
JWT_SECRET=change-me-to-a-long-random-string
# 首个管理员账号（首次启动自动创建）
ADMIN_EMAIL=boss@yourcompany.com
ADMIN_PASSWORD=change-this-password

# ---------- 数据库（不填则用内存演示库，重启即清空） ----------
# 云服务器/Docker：postgres://user:pass@localhost:5432/waimao
# Mac mini 原生（Homebrew）：postgres://你的Mac用户名@localhost:5432/waimao
DATABASE_URL=

# ---------- 出海代理（可选） ----------
# 服务器/Mac mini 本身无法直连 Google/LinkedIn/海外 API 时填（如境内自建）。
# 例：http://127.0.0.1:7890 （本机科学上网软件的 HTTP 代理端口）
OUTBOUND_PROXY=

# ---------- 联邦：自动获客系统（Python，可选） ----------
# 填了这个地址，主系统「主动客户开发」会内嵌那套更强的自动获客系统（多源找客户/
# 邮箱验证/送达率基建/AI 写信/CRM）。它用自己的一套服务启动（见 services/getke），
# 默认前端在 3000 端口。例：http://192.168.1.50:3000（换成 Mac mini 的局域网 IP）
GETKE_WEB_URL=

# ---------- 第一批：核心（接上就能真用） ----------
# 大模型（打分/写开发信/脚本）。provider 任选：openai / deepseek / qwen / claude
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 可选：自定义兼容 OpenAI 的 base url（deepseek/qwen 已内置，无需填）
LLM_BASE_URL=
LLM_MODEL=

# 发信邮箱 SMTP（真实发送开发信）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=

# ---------- 第二批：获客引擎 ----------
# 抓取：Crawl4AI 自建服务地址（跑大批量）
CRAWL4AI_URL=
# 抓取：Firecrawl（兜底反爬），托管 API key
FIRECRAWL_API_KEY=
# 搜索找公司：SerpAPI key
SERPAPI_KEY=
# 找邮箱：hunter / apollo
EMAIL_FINDER_PROVIDER=hunter
EMAIL_FINDER_KEY=
# 海关数据（可选）：volza key（ImportYeti 无公开 API，走抓取）
CUSTOMS_API_KEY=

# ---------- 第三批：内容与触达（可延后） ----------
# 视频生成：provider=keling/jimeng/hailuo，url+key
VIDEO_API_PROVIDER=
VIDEO_API_URL=
VIDEO_API_KEY=
# WhatsApp 通道A：官方 Business API（合规、需企业号+模板审批+按对话计费）
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# WhatsApp 通道B：协议/网页版（扫码挂现有号，续用历史，低量老客户维护）
# off=关闭；demo=桩演示（不真连，联调用）；baileys=真实直连
#   启用 baileys 需在 server 目录装依赖：npm i @whiskeysockets/baileys qrcode
#   境内 Mac mini 请配 OUTBOUND_PROXY，并装：npm i https-proxy-agent socks-proxy-agent
WHATSAPP_CHANNEL=off
# 会话/登录态存储目录（默认 server/storage/whatsapp）
WHATSAPP_SESSION_DIR=
# 两条消息最小间隔毫秒（防封限速，默认 8000）
WHATSAPP_MIN_SEND_GAP_MS=8000

# ---------- 文件存储（产品图/视频，不填则存服务器本地磁盘） ----------
# 例：阿里云 OSS / 腾讯云 COS，留空用本地 ./storage
OSS_ENDPOINT=
OSS_BUCKET=
OSS_KEY=
OSS_SECRET=
